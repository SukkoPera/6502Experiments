acme -I ../wic64-library --color -l labels "$name".asm


start_address="$(grep <labels -E "\sstart\s+=" | sed 's/.*= \$//' | sed 's/\s.*//')"
exomizer sfx 0x"$start_address" -B -n -o "$name-ex".prg -- "$name".prg
ls -lsa "$name"*

c1541 -format "$name,11" d64 "$name".d64 -attach "$name".d64 8 \
	-write "$name-ex.prg" "$name"



